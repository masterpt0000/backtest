# REST da QuestDB (porta 9000 por defeito). O QuestDB tem de estar a correr antes do FastAPI.
# Preferir 127.0.0.1 em vez de localhost se houver falhas de ligação (IPv6).
# Servidor remoto (Linux na LAN): expõe a porta 9000 no firewall ou usa reverse-proxy que sirva /exec.
# QUESTDB_HTTP_URL=http://192.168.1.216:9000
QUESTDB_HTTP_URL=http://127.0.0.1:9000
QUESTDB_CANDLES_TS_COL=local_ts
# Origens CORS (Next dev): separadas por vírgula
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Live: o botão Chart → Live chama POST /api/live/store/start (arranca store.py no mesmo venv que o uvicorn).
# Para desativar o arranque remoto: LIVE_STORE_DISABLED=1
# LIVE_STORE_DISABLED=1

# Feed live em memória (CCXT Pro): o Next envia ``?code=BTC/USDT:USDT`` no snapshot/velas — não usa QuestDB.
# Dependência: pip install ccxt (já em requirements.txt)

# PostgreSQL (estratégias, jobs, parâmetros). Opcional: sem isto a API funciona só com QuestDB.
# Se definires DATABASE_URL mas o Postgres não estiver a correr, o arranque pode falhar após ~8s
# (timeout); comenta a linha ou arranca o Postgres. Com Docker: docker compose up -d postgres → 5433
# DATABASE_URL=postgresql+psycopg://backtest:backtest@127.0.0.1:5433/backtest_app

# Backtests vectorbt (opcional)
# BACKTEST_MAX_SYMBOL_WORKERS=3
# BACKTEST_QUESTDB_CONCURRENCY=4
# BACKTEST_PREFILTER=1
# BACKTEST_PREFILTER_MULT=0.85
